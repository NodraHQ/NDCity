# Copie para .env.local (no seu computador) ou cole estas variáveis em
# Vercel > Project > Settings > Environment Variables.

# Senha da página /admin (escolha uma senha forte)
ADMIN_PASSWORD=troque-esta-senha

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave secreta ("secret" / "service_role"). NUNCA coloque no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço do site (usado nos links e no Mercado Pago)
NEXT_PUBLIC_SITE_URL=https://ndcity.vercel.app

# Mercado Pago (opcional: sem ele, o admin libera os recursos manualmente)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Opcional: Google Analytics (ex.: G-XXXXXXX)
NEXT_PUBLIC_GA_ID=
