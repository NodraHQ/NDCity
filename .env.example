# Copie este arquivo para .env.local (no seu computador) ou cole estas
# variáveis em Vercel > Project > Settings > Environment Variables.

# Senha da página /admin (escolha uma senha forte)
ADMIN_PASSWORD=troque-esta-senha

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Use a chave secreta ("secret" / "service_role"). NUNCA coloque no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: nome do perfil do Instagram mostrado no site (sem @)
NEXT_PUBLIC_INSTAGRAM_PROFILE=

# Opcional: Google Analytics (ex.: G-XXXXXXX). O painel de acessos do admin
# funciona sem isso.
NEXT_PUBLIC_GA_ID=
